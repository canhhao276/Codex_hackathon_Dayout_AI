# Copy this file to .env and fill in your key. .env is git-ignored.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Timeouts (seconds). Measured: gpt-4o ~2.3s per call (gpt-4o-mini 3-5s on venue Wi-Fi).
OPENAI_TIMEOUT_GENERATE=6.0
OPENAI_TIMEOUT_REPLAN=4.5
OSRM_TIMEOUT=2.5
OVERPASS_TIMEOUT=2.5

# Free public services (no key needed)
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
